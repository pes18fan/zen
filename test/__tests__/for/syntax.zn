// basic
for var c = 0; c < 3; {
    echo c = c + 1;
};
// expect: 1
// expect: 2
// expect: 3

// full loop
for var a = 0; a < 3; a = a + 1 {
    echo a;
};
// expect: 0
// expect: 1
// expect: 2

// no variable
var i = 0;
for ; i < 2; i = i + 1 {
    echo i;
};
// expect: 0
// expect: 1

// no increment
for var i = 0; i < 2; {
    echo i;
    i = i + 1
}
// expect: 0
// expect: 1
