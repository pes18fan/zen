// variable declaration and assignment
var a = 10;
puts(a);            // expect: 10

a = 20;
puts(a);            // expect: 20

// val (single-assign)
val name = "zen";
puts(name);         // expect: zen

// shadowing
var v = "outer";
{
    var v = "inner";
    puts(v);        // expect: inner
};
puts(v);            // expect: outer
