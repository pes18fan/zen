var f;
var g;

{
    var local = "local";
    func f_() {
        echo local;
        local = "after f";
        echo local
    };
    f = f_;

    func g_() {
        echo local;
        local = "after g";
        echo local
    };
    g = g_
};

f();
// expect: "local"
// expect: "after f"

g()
// expect: "after f"
// expect: "after g"
