// Nested Results should unwrap cleanly through multiple layers,
// exercising generic instantiation of Result[a, b] where a itself
// is another Result.
use "result";

val ok = result.ok;
val unwrap = result.unwrap;

val nested = ok(ok(5));

puts(unwrap(unwrap(nested))); // expect: 5

func wrap_twice(x) {
    ok(ok(x))
};

puts(unwrap(unwrap(wrap_twice("deep")))); // expect: deep
