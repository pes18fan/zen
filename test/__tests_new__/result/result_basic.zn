// Basic Result construction and unwrap on Ok variants
use "result";

val k = result.ok(1);

puts(result.unwrap(k))          ; // expect: 1
puts(result.unwrap(result.ok("hello"))); // expect: hello

func safe_div(a, b) {
    if b == 0 {
        result.err("cannot divide by zero")
    } else {
        result.ok(a / b)
    }
};

puts(result.unwrap(safe_div(1, 4))); // expect: 0.250
puts(result.unwrap(safe_div(1, 2))); // expect: 0.500
