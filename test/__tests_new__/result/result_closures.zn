// Closures that capture state and return Results
use "result"

func make_validator(min) {
    return func(x) {
        if x < min {
            result.err("value too small")
        } else {
            result.ok(x)
        }
    }
}

val at_least_5 = make_validator(5)

puts(result.unwrap(at_least_5(10))) // expect: 10
