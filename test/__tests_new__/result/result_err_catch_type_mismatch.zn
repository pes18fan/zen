// catch's fallback must unify with the ok variant's inner type.
// safe_div's ok branch is constrained to Number (via a / b), so a
// String fallback should be a type error.
func safe_div(a, b) {
    if b == 0 {
        err("cannot divide by zero")
    } else {
        ok(a / b)
    }
}

puts(safe_div(1, 0) catch "fallback") // ERR: Expected fallback value to be of type Number, got String.
