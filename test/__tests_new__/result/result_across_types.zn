// A single wrapping function should work with values of any type,
// without being restricted to a single concrete type.
use "result";

func wrap(x) {
    ok(x)
};

puts(result.unwrap(wrap(1)))   ; // expect: 1
puts(result.unwrap(wrap("hi"))); // expect: hi
puts(result.unwrap(wrap(0.25))); // expect: 0.250
