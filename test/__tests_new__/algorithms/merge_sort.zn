// Merge sort
use "list";
use "math";

func merge(a, b, less) {
    var result = [];
    var i = 0;
    var j = 0;
    while i < len(a) and j < len(b) {
        if less(a[i], b[j]) {
            result = result |> list.push(a[i]);
            i = i + 1
        } else {
            result = result |> list.push(b[j]);
            j = j + 1
        }
    };
    while i < len(a) {
        result = result |> list.push(a[i]);
        i = i + 1
    };
    while j < len(b) {
        result = result |> list.push(b[j]);
        j = j + 1
    };
    result
};

func merge_sort(l, less) {
    if len(l) <= 1 {
        l
    } else {
        var mid = math.floor(len(l) / 2);
        var left = [];
        var right = [];
        for var i = 0; i < len(l); i = i + 1 {
            if i < mid {
                left = left |> list.push(l[i])
            } else {
                right = right |> list.push(l[i])
            }
        };
        merge(merge_sort(left, less), merge_sort(right, less), less)
    }
};

func num_less(a, b) => a < b;

var nums = [5, 3, 8, 1, 9, 2, 7, 4, 6];
echo merge_sort(nums, num_less);   // expect: [1, 2, 3, 4, 5, 6, 7, 8, 9]

func str_less(a, b) => len(a) < len(b);

var words = ["banana", "apple", "cherry"];
echo merge_sort(words, str_less)   // expect: ["apple", "cherry", "banana"]
