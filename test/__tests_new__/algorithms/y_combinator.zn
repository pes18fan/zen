// The Y combinator. It is a combinator (function whose output depends only
// on its arguments) that is best known for being a solution to the problem of
// recursively calling an anonymous function.

func y(f) {
    func g(x) {
        f(func(v) => x(x)(v))
    };
    g(g)
};

func fact_gen(self) {
    func(n) => if n == 0 { 1 } else { n * self(n - 1) }
};

var fact = y(fact_gen);
puts(fact(5));  // expect: 120

func fib_gen(self) {
    func(n) => if n < 2 { n } else { self(n - 1) + self(n - 2) }
};

var fib = y(fib_gen);
puts(fib(10))   // expect: 55
