// Ackermann-Peter function - stresses deep, non-primitive recursion.
func ackermann(m, n) {
    if m == 0 {
        n + 1
    } else {
        if n == 0 {
            ackermann(m - 1, 1)
        } else {
            ackermann(m - 1, ackermann(m, n - 1))
        }
    }
};

puts(ackermann(2, 3));  // expect: 9
puts(ackermann(3, 3));  // expect: 61
// puts(ackermann(3, 4))   // this one overflows
