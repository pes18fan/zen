// DRAFT
// proposed record syntax: subject to change
type Point = (x, y)
type Vector3 = (x: Int, y: Int, z: Int) // explicit type annotations

// creating one
// i am going all in on records; they are usable both positionally and in a
// named manner, so there will be no tuples
val p = Point(1, 2)     // positional
val q = Vector3(x = 1, y = 2, z = 3)    // named

puts(p)     // expect: (x = 1, y = 2)
puts(q)     // expect: (x = 1, y = 2, z = 3)

puts(p.x)   // expect: 1
puts(q.z)   // expect: 3

// record update syntax
val r = p with (y = 3)
puts(r)     // expect: (x = 1, y = 3)

// in pipelines
val s = q
    |> it with (y = 7)
    |> it with (z = 9)
    |> puts()   // expect: (x = 1, y = 7, z = 9)

// the empty record/unit
val u = ()

// structural equality
type Size = (x, y)
assert(Size(1, 2) == Point(1, 2))

// distinct keyword for escaping structural equality
type DSize = distinct (x, y)
assert(Size(1, 2) != DSize(1, 2))
