var empty = [];
puts(len(empty)); // expect: 0

empty = [1, 2, 3];
puts(len(empty)); // expect: 3

var matrix = [[1], [2, 3]];
puts(len(matrix)); // expect: 2

// now with annotations
var nested: List[List[Number]] = [];
nested = [[1, 2], [3, 4]];
puts(len(nested)); // expect: 2

var labels: List[String] = ["one", "two", "three"];
puts(len(labels)); // expect: 3
